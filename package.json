{
  "name": "@romashka_rv/frontend-config",
  "version": "4.0.0",
  "description": "Shared configs for frontend: ESLint 9, Stylelint 17, Prettier 3, Commitlint 21, TypeScript 6 (Next.js 16, React 19)",
  "repository": "https://github.com/RomashkaRV/frontend.configs",
  "author": "RomashkaRV",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js",
    "./stylelint": "./stylelint.config.js",
    "./commitlint": "./commitlint.config.cjs",
    "./tsconfig": "./tsconfig.json",
    "./package.json": "./package.json"
  },
  "files": [
    "eslint.config.js",
    "prettier.config.js",
    "stylelint.config.js",
    "commitlint.config.cjs",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-react/eslint-plugin": "5.30.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-helpers": "2.0.2",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.3",
    "typescript-eslint": "8.72.2"
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.9.0",
    "stylelint": "^17.16.0",
    "typescript": ">=5.9.0 <6.1.0"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write ."
  }
}
